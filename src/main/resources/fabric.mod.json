{
  "schemaVersion": 1,
  "id": "mavencraft",
  "version": "${version}",
  "name": "MavenCraft",
  "description": "Client utilities, creeper explosion controls, and optional Fantastic Wings persistence.",
  "authors": [
    "mavenried"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/mavencraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mavencraft.MavenCraftMod"
    ],
    "client": [
      "com.mavencraft.MavenCraftClient"
    ],
    "modmenu": [
      "com.mavencraft.MavenCraftModMenu"
    ]
  },
  "mixins": [
    "mavencraft.mixins.json",
    {
      "config": "mavencraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "fabric-api": "*",
    "minecraft": "~26.3"
  },
  "suggests": {
    "fantasticwings": "*"
  }
}
